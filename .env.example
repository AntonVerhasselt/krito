# Frontend / local Convex selector. This file contains no credentials.
CONVEX_DEPLOYMENT=dev:majestic-sturgeon-687
NEXT_PUBLIC_CONVEX_URL=https://majestic-sturgeon-687.eu-west-1.convex.cloud
KRITO_BACKEND_ENV=development

# Public PostHog ingestion settings; analytics requires user consent.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_KRITO_ENVIRONMENT=local
# Local browser verification only; omit from hosted deployments.
# NEXT_PUBLIC_POSTHOG_DEBUG=true
# Optional release identifier; hosted builds can use NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA.
# NEXT_PUBLIC_KRITO_RELEASE=

# Private build-only source-map settings (never prefix with NEXT_PUBLIC_):
# POSTHOG_PERSONAL_API_KEY, POSTHOG_PROJECT_ID
# Optional account setup input: .secrets/posthog.env (chmod 600).

# Backend variables are set on Convex development, not in Vercel or the browser:
# APP_ENV, OPENAI_API_KEY, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, AI_PRIMARY_MODEL, AI_RECHECK_MODEL,
# CONVERTER_URL, CONVERTER_USERNAME, CONVERTER_PASSWORD (set by npm run infra:converter),
# POSTHOG_PROJECT_TOKEN and POSTHOG_HOST are required for backend codegen/publication
# after installing the PostHog component (set by npm run env:posthog).
# E-mail (Resend, see docs/setup.md): RESEND_API_KEY, RESEND_WEBHOOK_SECRET,
# EMAIL_MODE (off | allowlist | live), EMAIL_ALLOWLIST, EMAIL_FROM, EMAIL_REPLY_TO,
# EMAIL_LINK_SECRET, SITE_URL; WELCOME_DELAY_SCALE only for testing.
# Optional local protected input: .secrets/development.env (chmod 600).
