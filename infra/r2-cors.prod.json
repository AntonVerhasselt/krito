{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://krito.be",
          "https://www.krito.be"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "Content-Type",
          "x-amz-checksum-crc32",
          "x-amz-sdk-checksum-algorithm"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
